# Public website URL, without trailing slash
NEXT_PUBLIC_SITE_URL=https://iplantjo.com

# Official iRoof product website
NEXT_PUBLIC_IROOF_URL=https://www.iroofgr.com

# AgriSim Early Access application. Switch to the branded subdomain only after
# Netlify custom-domain and TLS checks pass.
NEXT_PUBLIC_AGRISIM_URL=https://iplant-agrisim.netlify.app

# Existing-client controller platform. Leave empty until the final domain is confirmed.
NEXT_PUBLIC_CONTROLLER_URL=
# NEXT_PUBLIC_CONTROLLER_PORTAL_URL=  # accepted as a legacy alias

# Contact form delivery
CONTACT_EMAIL=info@iplantjo.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=iPlant website <website@iplantjo.com>

# Optional public profiles and analytics
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_ANALYTICS_ID=
