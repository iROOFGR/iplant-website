{
  "name": "iplant",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5200",
    "build": "next build",
    "start": "next start -p 5200",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:source": "node scripts/validate-source.mjs",
    "check": "npm run validate:content && npm run validate:source && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.3.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
  }
}
